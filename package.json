{
  "name": "cv-studio",
  "productName": "CV Studio",
  "version": "0.5.0",
  "description": "Application de bureau pour éditer un CV de référence et générer des variantes de CV.",
  "author": "WolfGang-PRoxa",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "main": "src/main/main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/WolfGang-PRoxa/cv.git"
  },
  "scripts": {
    "start": "electron .",
    "check": "node scripts/check.mjs",
    "dist": "electron-builder --win --publish never",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "allowScripts": {
    "electron-winstaller": false
  },
  "build": {
    "appId": "fr.wolfgangproxa.cvstudio",
    "productName": "CV Studio",
    "copyright": "Copyright © 2026 WolfGang-PRoxa",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "CV-Studio-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "shortcutName": "CV Studio"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "WolfGang-PRoxa",
        "repo": "cv",
        "releaseType": "release"
      }
    ]
  }
}
